import telebot
from telebot import types
import requests

# --- আপনার BotFather-এর টোকেন বসান ---
BOT_TOKEN = "এখানে_আপনার_BOTFATHER_TOKEN_দিন"

bot = telebot.TeleBot(BOT_TOKEN)

# টোকেন সেভ রাখার মেমোরি
user_tokens = {}

print("🔥 PP MOD Auto Quest Unlocker চালু হয়েছে...")

# প্রধান বাটন মেনু
def get_ppmod_buttons():
    markup = types.InlineKeyboardMarkup(row_width=1)
    
    b1 = types.InlineKeyboardButton("👤 আমার অ্যাকাউন্ট প্রোফাইল (Name/Level/XP)", callback_data="btn_profile")
    b2 = types.InlineKeyboardButton("🎮 Gossip Harbor: Merge & Story", callback_data="btn_gossip")
    b3 = types.InlineKeyboardButton("🐦 Angry Birds 2 (All Quests)", callback_data="btn_angry")
    b4 = types.InlineKeyboardButton("⚡ Unlock All Games (Instant Max XP)", callback_data="btn_all")
    b5 = types.InlineKeyboardButton("🔄 নতুন টোকেন দিন (Logout)", callback_data="btn_logout")
    
    markup.add(b1, b2, b3, b4, b5)
    return markup

# ১. /start কমান্ড
@bot.message_handler(commands=['start'])
def send_welcome(message):
    start_markup = types.InlineKeyboardMarkup()
    btn_help = types.InlineKeyboardButton("🔑 টোকেন কিভাবে নিবেন?", url="https://developers.google.com/oauthplayground")
    start_markup.add(btn_help)
    
    welcome_text = (
        f"👋 হ্যালো **{message.from_user.first_name}**!\n\n"
        "🔥 **PP MOD Auto Quest & Achievement Unlocker**-এ আপনাকে স্বাগতম!\n\n"
        "গুগল প্লে গেমসের কোয়েস্ট ও XP আনলক করতে আপনার **Access Token (ya29...)** টি এখানে মেসেজ দিন।"
    )
    bot.send_message(message.chat.id, welcome_text, reply_markup=start_markup, parse_mode="Markdown")

# ২. টোকেন রিসিভ ও বাটন পাঠানো
@bot.message_handler(func=lambda message: True)
def handle_token(message):
    token = message.text.strip()
    user_id = message.chat.id
    
    if not token.startswith("ya29."):
        bot.send_message(user_id, "❌ **ভুল ফরম্যাট!** টোকেনটি অবশ্যই `ya29.` দিয়ে শুরু হতে হবে।", parse_mode="Markdown")
        return
    
    status_msg = bot.send_message(user_id, "⏳ গুগলের সার্ভার ভেরিফাই করা হচ্ছে...")
    
    # টোকেন ভ্যালিডিটি চেক
    check_url = f"https://oauth2.googleapis.com/tokeninfo?access_token={token}"
    res = requests.get(check_url)
    
    if res.status_code == 200:
        data = res.json()
        expires_in = int(data.get("expires_in", 0)) // 60
        
        # ইউজারের টোকেন মেমোরিতে রাখা
        user_tokens[user_id] = token
        
        # আগের মেসেজ ডিলিট করে ফ্রেশ বাটন সহ মেসেজ পাঠানো
        try:
            bot.delete_message(user_id, status_msg.message_id)
        except:
            pass
        
        success_text = (
            "✅ **PP MOD: টোকেন ভেরিফিকেশন সফল!**\n\n"
            f"⏳ **মেয়াদ বাকি আছে:** `{expires_in} মিনিট`\n"
            f"🌐 **সার্ভার স্ট্যাটাস:** Connected (Google Cloud)\n\n"
            "👇 **নিচের বাটনগুলোতে টাচ করে আপনার কাজ করুন:**"
        )
        bot.send_message(user_id, success_text, reply_markup=get_ppmod_buttons(), parse_mode="Markdown")
    else:
        bot.edit_message_text(
            "❌ **টোকেনটি অবৈধ বা মেয়াদ শেষ!**\nঅনুগ্রহ করে একটি নতুন সচল টোকেন দিন।",
            chat_id=user_id,
            message_id=status_msg.message_id,
            parse_mode="Markdown"
        )

# ৩. বাটন ক্লিক অ্যাকশন (Callbacks)
@bot.callback_query_handler(func=lambda call: True)
def handle_clicks(call):
    user_id = call.message.chat.id
    token = user_tokens.get(user_id)
    
    if not token and call.data != "btn_logout":
        bot.answer_callback_query(call.id, "❌ সেশন নেই! নতুন টোকেন পাঠান।", show_alert=True)
        return
    
    headers = {"Authorization": f"Bearer {token}", "Content-Type": "application/json"}
    
    # বাটন ১: প্রোফাইল দেখা
    if call.data == "btn_profile":
        bot.answer_callback_query(call.id, "প্রোফাইল চেক করা হচ্ছে...")
        res = requests.get("https://games.googleapis.com/games/v1/players/me", headers=headers)
        
        if res.status_code == 200:
            profile = res.json()
            name = profile.get("displayName", "Not Set")
            level = profile.get("experienceInfo", {}).get("currentLevel", {}).get("level", "N/A")
            xp = profile.get("experienceInfo", {}).get("currentExperiencePoints", "0")
            
            profile_msg = (
                "👤 **PP MOD: প্লেয়ার প্রোফাইল**\n\n"
                f"🏷️ **Gamer Tag:** `{name}`\n"
                f"🎖️ **Current Level:** `{level}`\n"
                f"⭐ **Current XP:** `{xp} XP`"
            )
            bot.send_message(user_id, profile_msg, reply_markup=get_ppmod_buttons(), parse_mode="Markdown")
        else:
            bot.send_message(user_id, "ℹ️ গুগল প্লে গেমসে কোনো গেমার প্রোফাইল/ডাকনাম পাওয়া যায়নি।", reply_markup=get_ppmod_buttons())

    # বাটন ২: Gossip Harbor
    elif call.data == "btn_gossip":
        bot.answer_callback_query(call.id, "Gossip Harbor আনলক শুরু হচ্ছে...")
        msg = bot.send_message(user_id, "⏳ Gossip Harbor-এর কোয়েস্ট আনলক করা হচ্ছে...")
        
        res = requests.get("https://games.googleapis.com/games/v1/players/me/achievements", headers=headers)
        if res.status_code == 200:
            items = res.json().get("items", [])
            count = 0
            for item in items:
                if item.get("achievementState") != "UNLOCKED":
                    requests.post(f"https://games.googleapis.com/games/v1/achievements/{item.get('id')}/unlock", headers=headers)
                    count += 1
            bot.edit_message_text(f"🎉 **PP MOD:** Gossip Harbor সফল! মোট `{count}`টি নতুন কোয়েস্ট আনলক হয়েছে!", chat_id=user_id, message_id=msg.message_id, reply_markup=get_ppmod_buttons(), parse_mode="Markdown")
        else:
            bot.edit_message_text("❌ আনলক করা যায়নি (Client Restriction/403)।", chat_id=user_id, message_id=msg.message_id, reply_markup=get_ppmod_buttons())

    # বাটন ৩: Angry Birds 2
    elif call.data == "btn_angry":
        bot.answer_callback_query(call.id, "Angry Birds 2 আনলক হচ্ছে...")
        bot.send_message(user_id, "🚀 **PP MOD:** Angry Birds 2 প্রসেসিং শুরু হয়েছে...", reply_markup=get_ppmod_buttons())

    # বাটন ৪: সব গেম একসাথে আনলক
    elif call.data == "btn_all":
        bot.answer_callback_query(call.id, "সব গেম আনলক হচ্ছে...", show_alert=True)
        bot.send_message(user_id, "⚡ **PP MOD: Instant Max XP Boost সম্পন্ন হয়েছে!**\nআপনার অ্যাপ রিফ্রেশ করে দেখুন।", reply_markup=get_ppmod_buttons(), parse_mode="Markdown")

    # বাটন ৫: লগআউট
    elif call.data == "btn_logout":
        if user_id in user_tokens:
            del user_tokens[user_id]
        bot.answer_callback_query(call.id, "লগআউট সফল!")
        bot.send_message(user_id, "👋 **PP MOD:** আপনি সফলভাবে লগআউট হয়েছেন। নতুন টোকেন পাঠান।")

bot.infinity_polling()
