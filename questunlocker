    print(f"\n{R}[✗] টোকেন খালি রাখা যাবে না!{W}")
    sys.exit()

achievements = [
    {"name": "First Flight (Level 1)",       "id": "CgkI-re9-Y8EEAIQAQ"},
    {"name": "Pig Popper (Pop 100 Pigs)",    "id": "CgkI-re9-Y8EEAIQAg"},
