import requests
import time
import sys

# ==========================================
#          VERSION CONFIGURATION
# (গিটহাবে এডিট করে ভার্সন নাম্বার বাড়াতে পারবেন)
# ==========================================
VERSION = "v2.5.0 [LIVE-UPDATE]"

# কালার কোডস
G = '\033[92m'  # Green
R = '\033[91m'  # Red
Y = '\033[93m'  # Yellow
C = '\033[96m'  # Cyan
M = '\033[95m'  # Magenta
W = '\033[0m'   # Reset
BOLD = '\033[1m'

def print_banner():
    print(f"""{C}{BOLD}
╔═══════════════════════════════════════════════════╗
║     ⚡ GPGS ACHIEVEMENT AUTO UNLOCKER ⚡         ║
║         GitHub Auto-Sync Edition                  ║
║         Current Version: {M}{VERSION}{C}         ║
╚═══════════════════════════════════════════════════╝{W}""")

print_banner()

# টোকেন ইনপুট নেওয়া
print(f"{Y}[?] HttpCanary থেকে পাওয়া আসল ya29... টোকেনটি পেস্ট করুন:{W}")
token = input(f"{BOLD}{C}Token > {W}").strip()

if not token or not token.startswith("ya29."):
    print(f"\n{R}[✗] অবৈধ টোকেন! টোকেনটি অবশ্যই 'ya29.' দিয়ে শুরু হতে হবে।{W}")
    sys.exit()

# গেমের অ্যাচিভমেন্ট লিস্ট (Angry Birds 2)
achievements = [
    {"name": "First Flight (Level 1)",       "id": "CgkI-re9-Y8EEAIQAQ"},
    {"name": "Pig Popper (Pop 100 Pigs)",    "id": "CgkI-re9-Y8EEAIQAg"},
    {"name": "Spell Caster (Use Spells)",    "id": "CgkI-re9-Y8EEAIQAw"},
    {"name": "Flock Master (Level 5)",       "id": "CgkI-re9-Y8EEAIQBA"},
    {"name": "Feather Power (Level 10)",     "id": "CgkI-re9-Y8EEAIQBQ"},
    {"name": "Bird Specialist (Level 20)",   "id": "CgkI-re9-Y8EEAIQBg"},
    {"name": "Arena Challenger (Play Arena)","id": "CgkI-re9-Y8EEAIQBw"},
    {"name": "Boss Smasher (Beat Boss)",     "id": "CgkI-re9-Y8EEAIQCg"}
]

headers = {
    "Authorization": f"Bearer {token}",
    "Content-Type": "application/json"
}

print(f"\n{M}[*] কানেকশন সফল! অ্যাচিভমেন্ট আনলক প্রক্রিয়া শুরু হচ্ছে...{W}\n")
time.sleep(1)

unlocked_count = 0
already_unlocked = 0
failed_count = 0

for ach in achievements:
    url = f"https://games.googleapis.com/games/v1/achievements/{ach['id']}/unlock"
    try:
        res = requests.post(url, headers=headers)
        if res.status_code == 200:
            data = res.json()
            if data.get("newlyUnlocked") == True:
                print(f"{G}[✓] SUCCESS:{W} {ach['name']} ➔ {G}+XP Added! (Unlocked){W}")
                unlocked_count += 1
            else:
                print(f"{Y}[!] ALREADY DONE:{W} {ach['name']} (আগে থেকেই ছিল)")
                already_unlocked += 1
        elif res.status_code == 401:
            print(f"\n{R}[✗] টোকেনের মেয়াদ শেষ হয়ে গেছে! HttpCanary থেকে নতুন টোকেন নিন।{W}")
            break
        else:
            print(f"{R}[✗] FAILED:{W} {ach['name']} | Status: {res.status_code}")
            failed_count += 1
    except Exception as e:
        print(f"{R}[✗] Network Error:{W} {ach['name']}")
        failed_count += 1

    time.sleep(0.4)

# সামারি রেজাল্ট
print(f"\n{C}══════════════════ [ RESULT SUMMARY ] ══════════════════{W}")
print(f"{G}নতুন আনলক হয়েছে  : {unlocked_count}{W}")
print(f"{Y}আগে থেকেই করা ছিল : {already_unlocked}{W}")
print(f"{R}ব্যর্থ হয়েছে       : {failed_count}{W}")
print(f"{C}════════════════════════════════════════════════════════{W}")

if unlocked_count > 0:
    print(f"\n{M}{BOLD}🎉 অভিনন্দন! Google Play Games অ্যাপে রিফ্রেশ করে দেখুন XP বেড়ে গেছে!{W}\n")
