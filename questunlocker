                err_msg = res.json().get('error', {}).get('message', res.text)
                print(f"{Y}   └─ Reason: {err_msg}{W}")
            except:
                pass
            failed_count += 1
            
    except Exception as e:
        print(f"{R}[✗] Network Error:{W} {ach['name']}")
