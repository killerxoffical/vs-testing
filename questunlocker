# ২. ইউজারের পাঠানো টোকেন রিসিভ ও ভেরিফাই
@bot.message_handler(func=lambda message: True)
def handle_token(message):
    token = message.text.strip()
    
    # টোকেন ফরম্যাট চেক
    if not token.startswith("ya29."):
        bot.reply_to(message, "❌ ভুল ফরম্যাট! টোকেনটি অবশ্যই `ya29.` দিয়ে শুরু হতে হবে।", parse_mode="Markdown")
        return
    
    status_msg = bot.reply_to(message, "⏳ গুগলের সার্ভার ভেরিফাই করা হচ্ছে...")
    
    # গুগলের সাথে টোকেন চেক
    check_url = f"https://oauth2.googleapis.com/tokeninfo?access_token={token}"
    res = requests.get(check_url)
    
    if res.status_code == 200:
        data = res.json()
        expires_in = int(data.get("expires_in", 0)) // 60
        scope = data.get("scope", "N/A")
        
        reply = (
            "✅ **টোকেন ভেরিফিকেশন সফল হয়েছে!**\n\n"
            f"🔑 **Authorized Scope:** `{scope}`\n"
            f"⏳ **মেয়াদ বাকি আছে:** `{expires_in} মিনিট`\n"
            f"🌐 **সার্ভার স্ট্যাটাস:** Connected (Google Cloud)\n\n"
            "🎮 এবার আপনি কোন গেমের কোয়েস্ট আনলক করতে চান সিলেক্ট করুন!"
        )
        bot.edit_message_text(reply, chat_id=message.chat.id, message_id=status_msg.message_id, parse_mode="Markdown")
    else:
        bot.edit_message_text(
            "❌ **টোকেনটি অবৈধ বা মেয়াদ শেষ (Expired)!**\nঅনুগ্রহ করে একটি নতুন সচল টোকেন দিন।",
            chat_id=message.chat.id,
            message_id=status_msg.message_id,
            parse_mode="Markdown"
        )

