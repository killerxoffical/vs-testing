import requests
import time
import sys
import json

VERSION = "v3.2.0 [PROFILE-VERIFIER]"

# কালার কোডস
G = '\033[92m'  # Green
R = '\033[91m'  # Red
Y = '\033[93m'  # Yellow
C = '\033[96m'  # Cyan
M = '\033[95m'  # Magenta
W = '\033[0m'   # Reset
BOLD = '\033[1m'

print(f"""{C}{BOLD}
╔═══════════════════════════════════════════════════╗
║     ⚡ GOOGLE PLAY GAMES ACCOUNT VERIFIER ⚡     ║
║            Version: {M}{VERSION}{C}          ║
╚═══════════════════════════════════════════════════╝{W}""")

print(f"{Y}[?] আপনার একদম টাটকা/নতুন ya29... টোকেনটি দিন:{W}")
token = input(f"{BOLD}{C}Token > {W}").strip()

if not token or not token.startswith("ya29."):
    print(f"\n{R}[✗] অবৈধ টোকেন! টোকেনটি অবশ্যই 'ya29.' দিয়ে শুরু হতে হবে।{W}")
    sys.exit()

headers = {
    "Authorization": f"Bearer {token}",
    "Content-Type": "application/json"
}

print(f"\n{M}[*] গুগল সার্ভার থেকে প্রোফাইল ডাটা আনা হচ্ছে...{W}\n")
time.sleep(1)

# ১. সরাসরি ইউজারের গুগল প্লে গেমস প্রোফাইল ডাটা আনা
profile_url = "https://games.googleapis.com/games/v1/players/me"
res = requests.get(profile_url, headers=headers)

if res.status_code == 401:
    print(f"{R}{BOLD}[✗] টোকেনের মেয়াদ শেষ (Expired) অথবা ভুল টোকেন! (Status: 401){W}")
    print(f"{Y}[i] অনুগ্রহ করে নতুন করে লগইন করে একদম টাটকা টোকেন কপি করুন।{W}\n")
    sys.exit()
elif res.status_code != 200:
    print(f"{R}[✗] অ্যাকাউন্ট কানেক্ট হয়নি! Error: {res.status_code}{W}")
    print(res.text)
    sys.exit()

profile = res.json()
name = profile.get("displayName", "Unknown")
player_id = profile.get("playerId", "Unknown")
exp_info = profile.get("experienceInfo", {})
current_level = exp_info.get("currentLevel", {}).get("level", "N/A")
current_xp = exp_info.get("currentExperiencePoints", "0")

# সুন্দর করে স্ক্রিনে প্রোফাইল প্রিন্ট করা
print(f"""{G}{BOLD}
╔════════════════ [ ACCOUNT LOGGED IN ] ════════════════╗
  👤 Gamer Name : {W}{name}{G}
  🆔 Player ID   : {W}{player_id}{G}
  🎖️ Current Level: {Y}{current_level}{G}
  ⭐ Current XP   : {Y}{current_xp} XP{G}
╚═══════════════════════════════════════════════════════╝{W}""")

print(f"\n{C}[✓] আপনার গুগল অ্যাকাউন্ট সফলভাবে কানেক্ট হয়েছে!{W}")
print(f"{M}[*] এবার অ্যাচিভমেন্ট আনলক করার চেষ্টা করা হচ্ছে...{W}\n")
time.sleep(1)

# ডেমো আনলক চেষ্টা
demo_ach = "CgkIoqf0_p0EEAIQAQ"
unlock_url = f"https://games.googleapis.com/games/v1/achievements/{demo_ach}/unlock"
unlock_res = requests.post(unlock_url, headers=headers)

if unlock_res.status_code == 200:
    print(f"{G}{BOLD}[✓] STATUS 200 OK: অ্যাচিভমেন্ট আনলক হয়েছে এবং নতুন XP যোগ হয়েছে!{W}\n")
else:
    print(f"{Y}[i] Unlock Status: {unlock_res.status_code}{W}")
    try:
        print(f"   Reason: {unlock_res.json().get('error', {}).get('message')}\n")
    except:
        pass
